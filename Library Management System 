CREATE TABLE Borrowings (
    BorrowingID NUMBER PRIMARY KEY,
    CustomerID NUMBER,
    BookID NUMBER,
    BorrowDate DATE,
    ReturnDate DATE,
    FOREIGN KEY (CustomerID) REFERENCES Member1(CustomerID),
    FOREIGN KEY (BookID) REFERENCES Books(BookID)
);

