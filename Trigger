CREATE OR REPLACE TRIGGER tdel
AFTER UPDATE OR DELETE ON voter
BEGIN
    IF UPDATING THEN
        DBMS_OUTPUT.PUT_LINE('Trigger Fired: Record Updated');
    ELSIF DELETING THEN
        DBMS_OUTPUT.PUT_LINE('Trigger Fired: Record Deleted');
    END IF;
END;
/

